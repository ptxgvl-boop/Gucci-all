-- [5.5] Anti Gucci Train
--============================================================
local trainAnti = {
    active = false,
    conn = nil,
    safePos = nil,
    restoreFrames = 0,
}

local function trainStart()
    local char, hum, hrp = getCharParts()
    if not hum or not hrp then return end
    trainAnti.safePos = hrp.Position

    local folder = workspace:FindFirstChild("Map")
    folder = folder and folder:FindFirstChild("AlwaysHereTweenedObjects")
    local train = folder and folder:FindFirstChild("Train")
    local seat
    if train then
        for _, d in ipairs(train:GetDescendants()) do
            if d:IsA("Seat") then seat = d break end
        end
    end

    if seat then
        hrp.CFrame = seat.CFrame + Vector3.new(0, 2, 0)
        seat:Sit(hum)
    end

    hum:GetPropertyChangedSignal("Jump"):Connect(function()
        if hum.Jump and hum.Sit then
            trainAnti.restoreFrames = 15
            trainAnti.safePos = hrp.Position
        end
    end)

    if trainAnti.conn then trainAnti.conn:Disconnect() end
    trainAnti.conn = RunService.Heartbeat:Connect(function()
        if not hrp or not hum then return end
        if RagdollRemote then
            pcall(function() RagdollRemote:FireServer(hrp, 0) end)
        end
        if trainAnti.restoreFrames > 0 then
            hrp.CFrame = CFrame.new(trainAnti.safePos)
            trainAnti.restoreFrames -= 1
        end
    end)

    task.spawn(function()
        while hum.Sit do task.wait(1) end
        task.wait(0.5)
        if hrp then hrp.CFrame = CFrame.new(trainAnti.safePos) end
    end)
end

local function trainStop()
    if trainAnti.conn then
        trainAnti.conn:Disconnect()
        trainAnti.conn = nil
    end
    local char, hum = getCharParts()
    if hum then
        hum.Sit = false
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
end

