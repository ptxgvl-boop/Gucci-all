--============================================================
-- [5.1] Master Gucciblob Loop
--============================================================
local GucciGlobal = {
    GUE = false,
    selectedType = "CreatureBlobman",
    gucciRunning = false,
    itm = nil, sp = nil, sv = nil, humconnection = nil,
    inexistance = {},
}

local gucciTypes = {
    ["Blobman"] = "CreatureBlobman",
    ["Tractor"] = "TractorGreen",
    ["Santa Sleigh"] = "SantaSleigh",
}

local function gucciDiddle()
    local hum, hrp = getCharParts()
    if not hum or not hrp then return end
    if GucciGlobal.itm then
        for _, prt in pairs(GucciGlobal.itm:GetChildren()) do
            if prt:IsA("BasePart") then prt.CanCollide = false end
        end
    end
    if GucciGlobal.sp then hrp.CFrame = GucciGlobal.sp end
    if GucciGlobal.sv then hrp.AssemblyLinearVelocity = GucciGlobal.sv end
    hum:GetPropertyChangedSignal("SeatPart"):Once(gucciDiddle)
end

local function gucciblob()
    if GucciGlobal.gucciRunning then return end
    GucciGlobal.gucciRunning = true

    local guccion = false
    local tickyticky = tick()

    while GucciGlobal.GUE do
        local char, hum, hrp = getCharParts()
        if hum and hrp then
            local dt = tick() - tickyticky
            tickyticky = tick()

            if GucciGlobal.itm and GucciGlobal.itm:FindFirstChild("VehicleSeat") then
                local occupant = GucciGlobal.itm.VehicleSeat.Occupant
                if occupant and occupant ~= hum then
                    task.spawn(function() destroyToy(GucciGlobal.itm) end)
                    GucciGlobal.itm = nil
                    guccion = false
                    GucciGlobal.inexistance = {}
                    task.wait(0.1)
                    if LocalPlayer:FindFirstChild("CanSpawnToy") and LocalPlayer.CanSpawnToy.Value then
                        task.spawn(function()
                            SpawnToyRF:InvokeServer(GucciGlobal.selectedType, hrp.CFrame * CFrame.new(0, 100000000, 10), Vector3.new(0, 0, 0))
                        end)
                    end
                    task.wait()
                    continue
                end
            end

            if GucciGlobal.itm and GucciGlobal.itm.Parent
                and not ((GucciGlobal.itm:FindFirstChild("HumanoidRootPart") or GucciGlobal.itm:FindFirstChild("SoundPart"))
                    and GucciGlobal.itm:FindFirstChild("VehicleSeat")
                    and (not GucciGlobal.itm.VehicleSeat.Occupant or GucciGlobal.itm.VehicleSeat.Occupant ~= hum)
                    or (GucciGlobal.inexistance[GucciGlobal.itm] or 0) < 1) then
                task.spawn(function() destroyToy(GucciGlobal.itm) end)
            else
                local toyFolder = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
                GucciGlobal.itm = toyFolder and toyFolder:FindFirstChild(GucciGlobal.selectedType)
            end

            if not GucciGlobal.sp or not hum.SeatPart then
                GucciGlobal.sp = hrp.CFrame
                GucciGlobal.sv = hrp.AssemblyLinearVelocity
            end

            if GucciGlobal.humconnection ~= hum then
                GucciGlobal.humconnection = hum
                hum:GetPropertyChangedSignal("SeatPart"):Once(gucciDiddle)
            end

            local waitFlag = true

            if GucciGlobal.itm then
                GucciGlobal.inexistance[GucciGlobal.itm] = (GucciGlobal.inexistance[GucciGlobal.itm] or 0) + dt

                local mainPart = GucciGlobal.itm:FindFirstChild("HumanoidRootPart") or GucciGlobal.itm:FindFirstChild("SoundPart")
                local seat = GucciGlobal.itm:FindFirstChild("VehicleSeat")

                if mainPart and seat and (not seat.Occupant or seat.Occupant == hum) then
                    if not guccion then
                        mainPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    end

                    seat.Parent = nil
                    seat.Parent = GucciGlobal.itm

                    if (hrp.CFrame.Position - mainPart.CFrame.Position).Magnitude < 28 then
                        for _, prt in pairs(GucciGlobal.itm:GetChildren()) do
                            if prt:IsA("BasePart") and prt.CanQuery then
                                grab(prt)
                            end
                        end
                    end

                    if not hum.SeatPart then
                        hum.Sit = false
                    else
                        waitFlag = false
                        task.wait()
                    end

                    if hrp and hum and mainPart and seat and (not seat.Occupant or seat.Occupant == hum) then
                        local ragdolled = hum:FindFirstChild("Ragdolled")
                        if ragdolled and ragdolled.Value then
                            guccion = false
                        end

                        if seat.Occupant == hum then
                            guccion = true
                        elseif not guccion then
                            task.wait()
                            waitFlag = false
                            if mainPart and seat and (not seat.Occupant or seat.Occupant == hum) then
                                local r2 = hum:FindFirstChild("Ragdolled")
                                if not r2 or not r2.Value then
                                    seat:Sit(hum)
                                    if RagdollRemote then
                                        RagdollRemote:FireServer(hrp, 0.016)
                                    end
                                end
                            end
                        end

                        if guccion then
                            mainPart.AssemblyLinearVelocity = Vector3.new(0, 1e15, 0)
                        else
                            local pingStat = game:GetService("Stats").Network.ServerStatsItem:FindFirstChild("Data Ping")
                            local pingVal = pingStat and pingStat:GetValue() or 100
                            if GucciGlobal.inexistance[GucciGlobal.itm] >= pingVal / 250 then
                                task.spawn(function() destroyToy(GucciGlobal.itm) end)
                                hum.Sit = true
                            end
                        end
                    end
                else
                    if guccion then hum.Sit = true end
                    guccion = false
                    if GucciGlobal.inexistance[GucciGlobal.itm] >= 1 then
                        task.spawn(function() destroyToy(GucciGlobal.itm) end)
                        if LocalPlayer:FindFirstChild("CanSpawnToy") and LocalPlayer.CanSpawnToy.Value then
                            task.spawn(function()
                                SpawnToyRF:InvokeServer(GucciGlobal.selectedType, hrp.CFrame * CFrame.new(0, 100000000, 10), Vector3.new(0, 0, 0))
                            end)
                        end
                    end
                end
            else
                if guccion then
                    guccion = false
                    hum.Sit = true
                end
                if LocalPlayer:FindFirstChild("CanSpawnToy") and LocalPlayer.CanSpawnToy.Value then
                    task.spawn(function()
                        SpawnToyRF:InvokeServer(GucciGlobal.selectedType, hrp.CFrame * CFrame.new(0, 100000000, 10), Vector3.new(0, 0, 0))
                    end)
                end
            end

            if waitFlag then
                task.wait()
                hum.Sit = false
            end
        else
            task.wait()
        end
    end
    GucciGlobal.gucciRunning = false
end

LocalPlayer.CharacterAdded:Connect(function(char)
