--============================================================
-- [2] HELPER FUNCTIONS
--============================================================
local function FWC(parent, name, timeout)
    return parent:FindFirstChild(name) or parent:WaitForChild(name, timeout or 3)
end

local function grab(part)
    if SetNetOwner and part and part.Parent then
        pcall(function()
            SetNetOwner:FireServer(part, part.CFrame)
        end)
    end
end

local function destroyToy(toy)
    if DestroyToy and toy and toy.Parent then
        pcall(function()
            DestroyToy:FireServer(toy)
        end)
    end
end

local function notify(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title or "XOCU",
            Text = text or "",
            Duration = 3,
        })
    end)
end

local function playSound()
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://129485210015224"
        s.Volume = 1
        s.Parent = game:GetService("SoundService")
        s:Play()
        s.Ended:Connect(function() s:Destroy() end)
    end)
end

local function getCharParts()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    return char, char:FindFirstChild("Humanoid"), char:FindFirstChild("HumanoidRootPart")
end

